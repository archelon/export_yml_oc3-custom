{{ header }} {{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ heading_title }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form" class="form-horizontal">
          <div class="form-group{% if error_name %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="feed[name]" value="{{ feed.name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
              {% if error_name %}
              <div class="text-danger">{{ error_name }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="feed[status]" id="input-status" class="form-control">
                {% if feed.status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-currency">{{ entry_currency }}</label>
            <div class="col-sm-10">
              <select name="feed[currency]" id="input-currency" class="form-control">
                {% for currency in currencies %}
                {% if currency.code == feed.currency %}
                <option value="{{ currency.code }}" selected="selected">{{ '(' ~ currency.code ~ ') ' ~ currency.title }}</option>
                {% else %}
                <option value="{{ currency.code }}">{{ '(' ~ currency.code ~ ') ' ~ currency.title }}</option>
                {% endif %}
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-company">{{ entry_company }}</label>
            <div class="col-sm-10">
              <input type="text" name="feed[company]" value="{{ feed.company }}" id="input-company" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-shopname">{{ entry_shopname }}</label>
            <div class="col-sm-10">
              <input type="text" name="feed[shopname]" value="{{ feed.shopname }}" maxlength="20" id="input-shopname" class="form-control" />
            </div>
          </div>
          <div class="form-group{% if error_categories %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-category">{{ entry_category }}</label>
            <div class="col-sm-10">
              {% set class = 'odd' %}
              {% for category in categories %}
              {% if class == 'even' %}
                {% set class = 'odd' %}
              {% else %}
                {% set class = 'even' %}
              {% endif %}
              <div class="{{ class }}">
                {% if category.category_id in feed.categories %}
                <input type="checkbox" name="feed[categories][]" value="{{ category.category_id }}" checked="checked" style="display: inline-block; margin-right: 10px;" />
                {{ category.name }}
                {% else %}
                <input type="checkbox" name="feed[categories][]" value="{{ category.category_id }}" style="display: inline-block; margin-right: 10px;" />
                {{ category.name }}
                {% endif %}
              </div>
              {% endfor %}
              <br>
              <a class="btn btn-success" onclick="$(this).parent().find(':checkbox').prop('checked', true);"><i class="fa fa-check"></i> {{ text_select_all }}</a>
              <a class="btn btn-danger" onclick="$(this).parent().find(':checkbox').prop('checked', false);"><i class="fa fa-times"></i> {{ text_unselect_all }}</a>
              {% if error_categories %}
              <div class="text-danger">{{ error_categories }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-in-stock">{{ entry_in_stock }}</label>
            <div class="col-sm-10">
              <select name="feed[in_stock]" id="input-in-stock" class="form-control">
                {% for stock_status in stock_statuses %}
                {% if stock_status.stock_status_id == feed.in_stock %}
                <option value="{{ stock_status.stock_status_id }}" selected="selected">{{ stock_status.name }}</option>
                {% else %}
                <option value="{{ stock_status.stock_status_id }}">{{ stock_status.name }}</option>
                {% endif %}
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-out-of-stock">{{ entry_out_of_stock }}</label>
            <div class="col-sm-10">
              <select name="feed[out_of_stock]" id="input-out-of-stock" class="form-control">
                {% for stock_status in stock_statuses %}
                {% if stock_status.stock_status_id == feed.out_of_stock %}
                <option value="{{ stock_status.stock_status_id }}" selected="selected">{{ stock_status.name }}</option>
                {% else %}
                <option value="{{ stock_status.stock_status_id }}">{{ stock_status.name }}</option>
                {% endif %}
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-image">{{ entry_image }}</label>
            <div class="col-sm-10">
              <select name="feed[image]" id="input-image" class="form-control">
                <option value="1" {% if feed.image == '1' %} selected="selected" {% endif %}>{{ entry_image_single }}</option>
                <option value="2" {% if feed.image == '2' %} selected="selected" {% endif %}>{{ entry_image_all }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-image-size">{{ entry_image_size }}</label>
            <div class="col-sm-10">
              <select name="feed[image_size]" id="input-image-size" class="form-control">
                <option value="1" {% if feed.image_size == '1' %} selected="selected" {% endif %}>600x600</option>
                <option value="2" {% if feed.image_size == '2' %} selected="selected" {% endif %}>{{ entry_image_original }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sales-notes"><span data-toggle="tooltip" title="{{ entry_sales_notes_help }}">{{ entry_sales_notes }}</span></label>
            <div class="col-sm-10">
              <input type="text" name="feed[sales_notes]" value="{{ feed.sales_notes }}" id="input-sales-notes" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_attributes }}</label>
            <div class="col-sm-10">
              <label class="radio-inline"><input type="radio" name="feed[attributes]" value="1" {% if feed.attributes == '1' %} checked="checked"{% endif %}> {{ text_yes }}</label>
              <label class="radio-inline"><input type="radio" name="feed[attributes]" value="0" {% if not feed.attributes %} checked="checked"{% endif %}> {{ text_no }}</label>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_options }}</label>
            <div class="col-sm-10">
              <label class="radio-inline"><input type="radio" name="feed[options]" value="1" {% if feed.options == '1' %} checked="checked"{% endif %}> {{ text_yes }}</label>
              <label class="radio-inline"><input type="radio" name="feed[options]" value="0" {% if not feed.options %} checked="checked"{% endif %}> {{ text_no }}</label>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-description">{{ entry_description }}</label>
            <div class="col-sm-10">
              <select name="feed[description]" id="input-description" class="form-control">
                {% if feed.description %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-data-feed">{{ entry_data_feed }}</label>
            <div class="col-sm-10">
              {% if feed_url %}
              <input type="text" value="{{ feed_url }}" id="input-data-feed" class="form-control" readonly />
              {% else %}
              <input type="text" value="{{ text_feed_url_after_save }}" id="input-data-feed" class="form-control" readonly />
              {% endif %}
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
